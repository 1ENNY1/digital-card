generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  github      String?
  linkedin    String?
  website     String?
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  sortOrder Int     @default(0)
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id           Int       @id @default(autoincrement())
  company      String
  position     String
  startDate    DateTime
  endDate      DateTime?
  achievements String[]
  profileId    Int
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  url         String
  description String?
  sortOrder   Int     @default(0)
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
